  nodes:
  - id: greet
    speaker: 
    text: "\uC654\uAD6C\uB098, {player}! \uC798 \uC7A4\uB2C8? \uC219\uC18C\uB294
      \uC880 \uCDA5\uC9C0 \uC54A\uC558\uACE0?"
    nextId: greet2
    choices: []
    effects: []
    actions: []
  - id: greet2
    speaker: 
    text: "\uC5EC\uAE30\uAC00 \uC6B0\uB9AC \uBE75\uC9D1\uC774\uC790 \uBC30\uB2EC
      \uC0AC\uBB34\uC18C\uC57C~ \uC800\uAE30 \uD734\uAC8C\uC2E4\uC5D0 \uC788\uB294
      \uB458\uC774 \uB124 \uB3D9\uB8CC\uB4E4\uC774\uACE0."
    nextId: greet3
    choices: []
    effects: []
    actions: []
  - id: greet3
    speaker: 
    text: "\uBCF4\uB9AC\uD55C\uD14C \uAC00\uBC29\uBD80\uD130 \uBC1B\uC544 \uC624\uB834.
      \uADF8\uB9AC\uACE0\u2026 \uD574 \uC9C0\uAE30 \uC804\uC5D4 \uAF2D \uC9D1\uC5D0
      \uB4E4\uC5B4\uAC00\uB834~"
    nextId: 
    choices: []
    effects:
    - key: briefed.d1
      operation: 0
      value: 1
    - key: heard.rule1
      operation: 0
      value: 1
    actions: []
  - id: need_bag
    speaker: 
    text: "\uBCF4\uB9AC\uD55C\uD14C \uAC00\uBC29\uBD80\uD130 \uBC1B\uC544 \uC624\uB834~
      \uD734\uAC8C\uC2E4\uC5D0 \uC788\uC744 \uAC70\uC57C."
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: ask
    speaker: 
    text: "\uAC00\uBC29 \uBC1B\uC558\uAD6C\uB098! \uC798 \uC5B4\uC6B8\uB9B0\uB2E4~
      \uADF8\uB7FC \uCCAB \uBC30\uB2EC! \uC774 \uBE75 \uBC14\uAD6C\uB2C8, \uC774\uC6C3
      \uD560\uBA38\uB2C8\uB124 \uC6B0\uD3B8\uD568\uC5D0 \uC880 \uB123\uC5B4 \uC904\uB798?"
    nextId: 
    choices:
    - text: "\uB124, \uB2E4\uB140\uC62C\uAC8C\uC694"
      nextId: accept
      conditions: []
    - text: "\uC9C0\uAE08\uC740 \uC880\u2026"
      nextId: later
      conditions: []
    effects: []
    actions: []
  - id: accept
    speaker: 
    text: "\uACE0\uB9C8\uC6CC~ \uD560\uBA38\uB2C8 \uB301\uC740 \uAD11\uC7A5 \uAC74\uB108
      \uB3D9\uCABD \uAE38 \uB05D\uC774\uC57C."
    nextId: 
    choices: []
    effects: []
    actions:
    - {fileID: 11400000, guid: c16771d964737434f8833a1397fc4235, type: 2}
  - id: later
    speaker: 
    text: "\uADF8\uB798\uADF8\uB798, \uCC9C\uCC9C\uD788 \uD574~ \uBE75\uC740 \uC2DD\uC5B4\uB3C4
      \uB9DB\uC788\uC73C\uB2C8\uAE4C!"
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: remind_bread
    speaker: 
    text: "\uD560\uBA38\uB2C8\uB124 \uC6B0\uD3B8\uD568\uC5D0 \uB123\uC5B4 \uC8FC\uBA74
      \uB3FC~ \uAD11\uC7A5 \uAC74\uB108 \uB3D9\uCABD \uAE38 \uB05D\uC774\uC57C."
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: after_bread
    speaker: 
    text: "\uD560\uBA38\uB2C8\uAC00 \uC88B\uC544\uD558\uC168\uC9C0? \uD560\uBA38\uB2C8\uB3C4
      \uB108\uD55C\uD14C \uBD80\uD0C1\uD560 \uAC8C \uC788\uB2E4\uB358\uB370~"
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: letter_receive
    speaker: 
    text: "\uC751? \uC544\uC774\uAC00 \uB098\uD55C\uD14C \uADF8\uB9BC\uC744?"
    nextId: letter_look
    choices: []
    effects: []
    actions:
    - {fileID: 11400000, guid: e783415ee195cac41b7bcaffa8d1a00e, type: 2}
  - id: letter_look
    speaker: 
    text: "\uC5B4\uBA38, \uC6B0\uB9AC \uAC00\uAC8C\uB124! \uC774\uAC74 \uB098, \uC774\uAC74
      \uD560\uBA38\uB2C8, \uC774\uAC74 \uC544\uC774\u2026 \uADF8\uB9AC\uACE0 \uC774
      \uAE38\uCB49\uD55C \uAC74 \uB204\uAD74\uAE4C~?"
    nextId: letter_gift
    choices: []
    effects: []
    actions: []
  - id: letter_gift
    speaker: 
    text: "\uD6C4\uD6C4, \uC798 \uADF8\uB838\uB124. \uC774 \uADF8\uB9BC\uC740 \uB124\uAC00
      \uAC00\uC9C0\uB834~ \uC9D1\uC5D0 \uAC78\uC5B4 \uB450\uBA74 \uC88B\uACA0\uB2E4."
    nextId: 
    choices: []
    effects:
    - key: gift.drawing
      operation: 0
      value: 1
    actions: []
  - id: settle
    speaker: 
    text: "\uC624\uB298 \uC815\uB9D0 \uC218\uACE0 \uB9CE\uC558\uC5B4, {player}. \uCCAB\uB0A0\uC778\uB370
      \uB2E4 \uD574\uB0C8\uB124!"
    nextId: settle2
    choices: []
    effects: []
    actions: []
  - id: settle2
    speaker: 
    text: "\uC774\uAC74 \uC624\uB298 \uC77C\uB2F9 \uB300\uC2E0\uC774\uC57C~ \uAC13
      \uAD6C\uC6B4 \uBE75!"
    nextId: rule1_again
    choices: []
    effects:
    - key: gift.bread
      operation: 0
      value: 1
    - key: settled.d1
      operation: 0
      value: 1
    actions: []
  - id: rule1_again
    speaker: 
    text: "\uBC8C\uC368 \uD574\uAC00 \uAE30\uC6B0\uB124. \uD574 \uC9C0\uAE30 \uC804\uC5D4
      \uAF2D \uC9D1\uC5D0 \uB4E4\uC5B4\uAC00\uB834~"
    nextId: 
    choices: []
    effects:
    - key: heard.rule1
      operation: 0
      value: 1
    actions: []
  - id: done
    speaker: 
    text: "\uC5BC\uB978 \uB4E4\uC5B4\uAC00~ \uD574 \uC9C0\uAE30 \uC804\uC5D0!"
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: d2
    speaker: 
    text: "\uC798 \uC7A4\uB2C8, {player}? \u2026\uB204\uB9AC \uC694\uC998 \uC880
      \uD070 \uAC83 \uAC19\uC9C0 \uC54A\uB2C8~? \uD6C4\uD6C4."
    nextId: d2_work
    choices: []
    effects: []
    actions: []
  - id: d2_work
    speaker: 
    text: "\uC624\uB298 \uBC30\uB2EC\uC740 \uC544\uC9C1 \uC900\uBE44 \uC911\uC774\uC57C.
      \uB3D9\uB124 \uD55C \uBC14\uD034 \uB3CC\uACE0 \uC624\uB834~"
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: d3
    speaker: 
    text: "\uC624\uB298\uB3C4 \uC798 \uBD80\uD0C1\uD574~ \uC544, \uC624\uB298 \uC800\uB141\uC5D4
      \uD2B9\uBCC4\uD55C \uBC30\uB2EC\uC774 \uD558\uB098 \uC788\uB2E8\uB2E4."
    nextId: 
    choices: []
    effects: []
    actions: []
