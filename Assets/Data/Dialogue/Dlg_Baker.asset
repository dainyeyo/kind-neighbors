  m_Script: {fileID: 11500000, guid: 30d07a71299c29046af4951d44642a04, type: 3}
  m_Name: Dlg_Baker
  m_EditorClassIdentifier: Assembly-CSharp::KindNeighbors.Dialogue.DialogueGraph
  speakerName: "\uBE75\uC9D1 \uC8FC\uC778"
  entries:
  - conditions:
    - key: delivered.Order_D1_Letter
      comparison: 0
      value: 1
    startNodeId: done
  - conditions:
    - key: accepted.Order_D1_Letter
      comparison: 0
      value: 1
    startNodeId: letter_receive
  - conditions:
    - key: delivered.Order_D1_Bread
      comparison: 0
      value: 1
    startNodeId: after_bread
  - conditions:
    - key: accepted.Order_D1_Bread
      comparison: 0
      value: 1
    startNodeId: remind_bread
  - conditions: []
    startNodeId: greet
  nodes:
  - id: greet
    speaker: 
    text: "\uC5B4\uBA38, \uB124\uAC00 \uC0C8\uB85C \uC628 \uBC30\uB2EC\uC6D0 {player}\uAD6C\uB098!
      \uB9C8\uCE68 \uC798 \uC654\uC5B4~"
    nextId: bag
    choices: []
    effects: []
    actions: []
  - id: bag
    speaker: 
    text: "\uC790, \uC774 \uAC00\uBC29\uBD80\uD130 \uBC1B\uC73C\uB834. \uC804 \uBC30\uB2EC\uC6D0\uC774
      \uC4F0\uB358 \uAC70\uC57C. \uC544\uC9C1 \uD2BC\uD2BC\uD574~"
    nextId: ask
    choices: []
    effects:
    - key: has.bag
      operation: 0
      value: 1
    actions: []
  - id: ask
    speaker: 
    text: "\uADF8\uB7FC \uCCAB \uBC30\uB2EC! \uC774 \uBE75 \uBC14\uAD6C\uB2C8, \uC774\uC6C3
      \uD560\uBA38\uB2C8\uB124 \uC6B0\uD3B8\uD568\uC5D0 \uC880 \uB123\uC5B4 \uC904\uB798?"
    nextId: 
    choices:
    - text: "\uB124, \uB2E4\uB140\uC62C\uAC8C\uC694"
      nextId: accept
      conditions: []
    - text: "\uC9C0\uAE08\uC740 \uC880\u2026"
      nextId: later
      conditions: []
    effects: []
    actions: []
  - id: accept
    speaker: 
    text: "\uACE0\uB9C8\uC6CC~ \uD560\uBA38\uB2C8 \uB301\uC740 \uAD11\uC7A5\uC5D0\uC11C
      \uC624\uB978\uCABD \uAE38 \uB05D\uC774\uC57C."
    nextId: rule1
    choices: []
    effects: []
    actions:
    - {fileID: 11400000, guid: c16771d964737434f8833a1397fc4235, type: 2}
  - id: rule1
    speaker: 
    text: "\uC544, \uADF8\uB9AC\uACE0\u2026 \uD574 \uC9C0\uAE30 \uC804\uC5D4 \uAF2D
      \uC9D1\uC5D0 \uB4E4\uC5B4\uAC00\uB834~"
    nextId: 
    choices: []
    effects:
    - key: heard.rule1
      operation: 0
      value: 1
    actions: []
  - id: later
    speaker: 
    text: "\uADF8\uB798\uADF8\uB798, \uCC9C\uCC9C\uD788 \uD574~ \uBE75\uC740 \uC2DD\uC5B4\uB3C4
      \uB9DB\uC788\uC73C\uB2C8\uAE4C!"
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: remind_bread
    speaker: 
    text: "\uD560\uBA38\uB2C8\uB124 \uC6B0\uD3B8\uD568\uC5D0 \uB123\uC5B4 \uC8FC\uBA74
      \uB3FC~ \uAD11\uC7A5\uC5D0\uC11C \uC624\uB978\uCABD \uAE38 \uB05D\uC774\uC57C."
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: after_bread
    speaker: 
    text: "\uD560\uBA38\uB2C8\uAC00 \uC88B\uC544\uD558\uC168\uC9C0? \uD560\uBA38\uB2C8\uB3C4
      \uB108\uD55C\uD14C \uBD80\uD0C1\uD560 \uAC8C \uC788\uB2E4\uB358\uB370~"
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: letter_receive
    speaker: 
    text: "\uC751? \uC544\uC774\uAC00 \uB098\uD55C\uD14C \uADF8\uB9BC\uC744?"
    nextId: letter_look
    choices: []
    effects: []
    actions:
    - {fileID: 11400000, guid: e783415ee195cac41b7bcaffa8d1a00e, type: 2}
  - id: letter_look
    speaker: 
    text: "\uC5B4\uBA38, \uC6B0\uB9AC \uAC00\uAC8C\uB124! \uC774\uAC74 \uB098, \uC774\uAC74
      \uD560\uBA38\uB2C8, \uC774\uAC74 \uC544\uC774\u2026 \uADF8\uB9AC\uACE0 \uC774
      \uAE38\uCB49\uD55C \uAC74 \uB204\uAD74\uAE4C~?"
    nextId: letter_gift
    choices: []
    effects: []
    actions: []
  - id: letter_gift
    speaker: 
    text: "\uD6C4\uD6C4, \uC798 \uADF8\uB838\uB124. \uC774 \uADF8\uB9BC\uC740 \uB124\uAC00
      \uAC00\uC9C0\uB834~ \uC9D1\uC5D0 \uAC78\uC5B4 \uB450\uBA74 \uC88B\uACA0\uB2E4."
    nextId: letter_end
    choices: []
    effects:
    - key: gift.drawing
      operation: 0
      value: 1
    actions: []
  - id: letter_end
    speaker: 
    text: "\uC624\uB298 \uC815\uB9D0 \uC218\uACE0 \uB9CE\uC558\uC5B4, {player}. \uC774\uAC74
      \uC624\uB298 \uC77C\uB2F9 \uB300\uC2E0\uC774\uC57C~ \uAC13 \uAD6C\uC6B4 \uBE75!"
    nextId: rule1_again
    choices: []
    effects:
    - key: gift.bread
      operation: 0
      value: 1
    actions: []
  - id: rule1_again
    speaker: 
    text: "\uBC8C\uC368 \uD574\uAC00 \uAE30\uC6B0\uB124. \uD574 \uC9C0\uAE30 \uC804\uC5D4
      \uAF2D \uC9D1\uC5D0 \uB4E4\uC5B4\uAC00\uB834~"
    nextId: 
    choices: []
    effects:
    - key: heard.rule1
      operation: 0
      value: 1
    actions: []
  - id: done
    speaker: 
    text: "\uC624\uB298 \uC218\uACE0 \uB9CE\uC558\uC5B4~ \uD574 \uC9C0\uAE30 \uC804\uC5D4
      \uAF2D \uC9D1\uC5D0 \uB4E4\uC5B4\uAC00\uB834~"
    nextId: 
    choices: []
    effects: []
    actions: []
