  nodes:
  - id: bag
    speaker: 
    text: "\uB124\uAC00 \uC2E0\uC785\uC774\uAD6C\uB098! \uB09C \uBCF4\uB9AC, 3\uB144
      \uCC28\uC57C~ \uBAA8\uB974\uB294 \uAC70 \uC788\uC73C\uBA74 \uB2E4 \uBB3C\uC5B4\uBD10!"
    nextId: bag2
    choices: []
    effects: []
    actions: []
  - id: bag2
    speaker: 
    text: "\uC790, \uC774\uAC70. \uC19C \uAC70\uC57C. \uC774\uC81C \uB124 \uAC70~"
    nextId: bag3
    choices: []
    effects:
    - key: has.bag
      operation: 0
      value: 1
    actions: []
  - id: bag3
    speaker: 
    text: "\uC19C\uC740 \uBC24 \uADFC\uBB34\uB77C\uC11C \uC774\uC81C \uC548 \uC368!
      \uC9C4\uC9DC \uC131\uC2E4\uD55C \uC560\uC57C~ \uAE38\uB3C4 \uC9C4\uC9DC \uC798
      \uC54C\uACE0."
    nextId: bag4
    choices: []
    effects: []
    actions: []
  - id: bag4
    speaker: 
    text: "\uC544, \uC800 \uBCBD\uC5D0 \uC218\uCE59 \uBD99\uC5B4 \uC788\uC9C0? \uAF2D
      \uC77D\uC5B4 \uB46C~ 1\uBC88\uC740 \uC624\uB298 \uB4E4\uC5C8\uC9C0?"
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: working
    speaker: 
    text: "\uAE38 \uBAA8\uB974\uACA0\uC73C\uBA74 \uAC8C\uC2DC\uD310 \uBD10~ \uC544,
      \uC19C\uC740 \uAC8C\uC2DC\uD310 \uC548 \uBCF4\uACE0\uB3C4 \uB2E4 \uC678\uC6E0\uB294\uB370!"
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: evening
    speaker: 
    text: "\uC624\uB298 \uC218\uACE0\uD588\uC5B4! \uB9C9\uCC28 \uB193\uCE58\uC9C0
      \uB9C8~ \uC218\uCE59 1\uBC88!"
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: d2_seen
    speaker: 
    text: "\uC5B4\uC82F\uBC24\uC5D0 \uCC3D\uBC16\uC73C\uB85C \uBB50 \uC9C0\uB098\uAC14\uC9C0?
      \uD0A4 \uD070 \uAC70."
    nextId: d2_seen2
    choices: []
    effects: []
    actions: []
  - id: d2_seen2
    speaker: 
    text: "\uC544~ \uADF8\uAC70 \uC19C\uC77C \uAC70\uC57C. \uC2E0\uC785 \uC654\uB2E4\uB2C8\uAE4C
      \uC778\uC0AC\uD558\uB7EC \uC654\uB098 \uBD10! \uD6C4\uD6C4."
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: d2
    speaker: 
    text: "\uC5B4\uC82F\uBC24 \uD479 \uC7A4\uC5B4? \uCCAB\uB0A0\uC740 \uC6D0\uB798
      \uD53C\uACE4\uD574~ \uC19C\uB3C4 \uCCAB\uB0A0\uC5D4 \uBC14\uB85C \uACEF\uC544\uB5A8\uC5B4\uC84C\uB300."
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: d3_opened
    speaker: 
    text: "\uC5B4\uBA38, \uCC3D\uBB38 \uC5F4\uC5B4 \uBD24\uC5B4? \uC19C\uC774 \uC88B\uC544\uD588\uACA0\uB2E4~"
    nextId: d3_opened2
    choices: []
    effects: []
    actions: []
  - id: d3_opened2
    speaker: 
    text: "\u2026\uB108 \uC624\uB298 \uC880 \uCEE4 \uBCF4\uC778\uB2E4? \uD6C4\uD6C4,
      \uAE30\uBD84 \uD0D3\uC778\uAC00."
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: d3_ignored
    speaker: 
    text: "\uC5B4\uC82F\uBC24\uC5D0 \uB611\uB611 \uC18C\uB9AC \uB0AC\uC9C0? \uC548
      \uC5F4\uC5C8\uC5B4? \uC798\uD588\uC5B4! \uC218\uCE59 2\uBC88!"
    nextId: 
    choices: []
    effects: []
    actions: []
  - id: d3
    speaker: 
    text: "\uC624\uB298\uC774 \uBC8C\uC368 \uC0AC\uD758\uC9F8\uB124~ \uC774\uC81C
      \uC644\uC804 \uC6B0\uB9AC \uB9C8\uC744 \uC0AC\uB78C\uC774\uB2E4!"
    nextId: 
    choices: []
    effects: []
    actions: []
