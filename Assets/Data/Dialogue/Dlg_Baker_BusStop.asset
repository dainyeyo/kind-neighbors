  nodes:
  - id: arrive
    speaker: 
    text: "\uC5B4\uBA38, \uD574 \uC9C0\uAE30 \uC804\uC5D0 \uC654\uB124! \uB2E4\uD589\uC774\uB2E4~"
    nextId: arrive2
    choices: []
    effects: []
    actions: []
  - id: arrive2
    speaker: 
    text: "\uB124\uAC00 {player}\uAD6C\uB098. \uC804\uB2E8 \uBCF4\uACE0 \uC628 \uAC70\uC9C0?
      \uBC18\uAC00\uC6CC~"
    nextId: arrive3
    choices: []
    effects: []
    actions: []
  - id: arrive3
    speaker: 
    text: "\u2026\uC9D0\uC774 \uADF8\uAC70 \uD558\uB098\uC57C? \uD6C4\uD6C4, \uAD1C\uCC2E\uC544.
      \uC5EC\uAE30 \uC624\uB294 \uC0AC\uB78C\uB4E4\uC740 \uB2E4 \uC0AC\uC815\uC774
      \uC788\uC9C0~ \uC548 \uBB3C\uC5B4\uBCFC\uAC8C."
    nextId: arrive4
    choices: []
    effects: []
    actions: []
  - id: arrive4
    speaker: 
    text: "\uC219\uC18C\uB294 \uBC14\uB85C \uC5EC\uAE30, \uC800 \uD558\uC580 \uC9D1\uC774\uC57C.
      \uBC30\uB2EC\uC6D0\uC740 \uB2E4 \uC5EC\uAE30\uC11C \uC2DC\uC791\uD574~"
    nextId: arrive5
    choices: []
    effects: []
    actions: []
  - id: arrive5
    speaker: 
    text: "\uC606\uC9D1\uC740\u2026 \uC9C0\uAE08\uC740 \uBE44\uC5B4 \uC788\uC5B4."
    nextId: arrive6
    choices: []
    effects: []
    actions: []
  - id: arrive6
    speaker: 
    text: "\uB0B4\uC77C \uC544\uCE68 \uBC84\uC2A4 \uD0C0\uACE0 \uB9C8\uC744\uB85C
      \uC624\uB834. \uB0B4\uB9AC\uBA74 \uBC14\uB85C \uAD11\uC7A5\uC774\uACE0, \uBE75\uC9D1\uC740
      \uAD11\uC7A5 \uC11C\uCABD\uC774\uC57C~"
    nextId: arrive7
    choices: []
    effects: []
    actions: []
  - id: arrive7
    speaker: 
    text: "\uADF8\uB7FC \uD479 \uC790~ \uB098\uB294 \uB9C9\uCC28 \uD0C0\uACE0 \uB4E4\uC5B4\uAC08\uAC8C!"
    nextId: 
    choices: []
    effects:
    - key: met.baker
      operation: 0
      value: 1
    actions: []
  - id: remind
    speaker: 
    text: "\uC5BC\uB978 \uB4E4\uC5B4\uAC00 \uC26C\uB834~ \uD574 \uB5A8\uC5B4\uC9C0\uAE30
      \uC804\uC5D0!"
    nextId: 
    choices: []
    effects: []
    actions: []
