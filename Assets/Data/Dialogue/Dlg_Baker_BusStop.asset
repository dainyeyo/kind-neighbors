    choices: []
    effects: []
    actions: []
  - id: arrive2
    speaker: 
    text: "\uB124\uAC00 {player}\uAD6C\uB098. \uC804\uB2E8 \uBCF4\uACE0 \uC628 \uAC70\uC9C0?
      \uBC18\uAC00\uC6CC~"
    nextId: arrive3
    choices: []
    effects: []
    actions: []
  - id: arrive3
    speaker: 
    text: "\u2026\uC9D0\uC774 \uADF8\uAC70 \uD558\uB098\uC57C? \uD6C4\uD6C4, \uAD1C\uCC2E\uC544.
      \uC5EC\uAE30 \uC624\uB294 \uC0AC\uB78C\uB4E4\uC740 \uB2E4 \uC0AC\uC815\uC774
      \uC788\uC9C0~ \uC548 \uBB3C\uC5B4\uBCFC\uAC8C."
    nextId: arrive4
    choices: []
    effects: []
    actions: []
  - id: arrive4
    speaker: 
    text: "\uC219\uC18C\uB294 \uC774 \uAE38 \uB530\uB77C \uCB49 \uB0B4\uB824\uAC00\uC11C,
      \uAD11\uC7A5 \uC9C0\uB098 \uB0A8\uCABD \uB05D \uD558\uC580 \uC9D1\uC774\uC57C."
    nextId: arrive5
    choices: []
    effects: []
    actions: []
  - id: arrive5
    speaker: 
    text: "\uB098\uB294 \uBA3C\uC800 \uAC00\uC11C \uBB38 \uC5F4\uC5B4 \uB458\uAC8C~
      \uCC9C\uCC9C\uD788 \uC640. \uD574 \uB5A8\uC5B4\uC9C0\uAE30 \uC804\uC5D0\uB9CC!"
    nextId: 
