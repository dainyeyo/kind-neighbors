  m_Script: {fileID: 11500000, guid: 77503d03735368d49b7c838fe4c3125c, type: 3}
  m_Name: Doc_RulesPoster
  m_EditorClassIdentifier: Assembly-CSharp::KindNeighbors.Home.DocumentAsset
  title: "\uBC30\uB2EC\uC6D0 \uC218\uCE59"
  paragraphs:
  - conditions: []
    text: "1. \uD574 \uC9C0\uAE30 \uC804\uC5D0 \uC9D1\uC5D0 \uB4E4\uC5B4\uAC08 \uAC83."
  - conditions:
    - key: heard.rule2
      comparison: 0
      value: 0
    text: "2. \u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592 (\uC704\uC5D0
      '\uD638\uB450\uBE75 \uD560\uC778' \uC804\uB2E8\uC774 \uB367\uBD99\uC5B4 \uC788\uB2E4)"
  - conditions:
    - key: heard.rule2
      comparison: 0
      value: 1
    text: "2. \uCC3D\uBB38\uC744 \uB450 \uBC88 \uB450\uB4DC\uB9AC\uBA74 \uC5F4\uC9C0
      \uB9D0 \uAC83."
  - conditions:
    - key: heard.rule3
      comparison: 0
      value: 0
    text: "3. \u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592\u2592 (\uC704\uC5D0
      '\uB178\uB780 \uBAA9\uB3C4\uB9AC\uB97C \uCC3E\uC2B5\uB2C8\uB2E4' \uC804\uB2E8\uC774
      \uB367\uBD99\uC5B4 \uC788\uB2E4)"
  - conditions:
    - key: heard.rule3
      comparison: 0
      value: 1
    text: "3. \uC774\uB984\uC744 \uBD88\uB7EC\uB3C4 \uB300\uB2F5\uD558\uC9C0 \uB9D0
      \uAC83."
  - conditions: []
    text: "\u203B \uC218\uCE59\uC744 \uC9C0\uD0A4\uC9C0 \uC54A\uC740 \uBC30\uB2EC\uC6D0\uC740
      \uBC24 \uADFC\uBB34\uB85C \uC804\uD658\uB420 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  emptyText: "(\uC544\uC9C1 \uC544\uBB34\uAC83\uB3C4 \uC801\uD600 \uC788\uC9C0 \uC54A\uB2E4)"
  compact: 0
